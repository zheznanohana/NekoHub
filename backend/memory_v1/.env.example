# The base URL must include the path prefix the provider expects before
# /chat/completions. DeepSeek: https://api.deepseek.com/v1 (models: deepseek-flash).
MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
MEMORY_LLM_MODEL=deepseek-flash
MEMORY_LLM_API_KEY=
MEMORY_SERVICE_TOKEN=
MEMORY_SERVICE_URL=http://127.0.0.1:18081
# Use the same absolute database path for service, web and worker.
MEMORY_DB_PATH=
MEMORY_AUTO_APPLY=false
# Jobs the worker processes per 60s tick. Raise it to drain a bulk import,
# then put it back: each job is one model call.
# Output budget per model call. Reasoning models spend part of it thinking,
# and a truncated reply is rejected, so leave headroom.
MEMORY_LLM_MAX_TOKENS=12000
MEMORY_WORKER_BATCH=1
# Historical day/week/month summaries generated per tick. Imported history has
# no layers above it until these run; each one is a model call.
MEMORY_BACKFILL_BATCH=2
MEMORY_CONNECTOR_OWNER=admin
# pi runs chat through the Pi agent subprocess; unset falls back to the
# built-in bounded tool loop. Needs Node on PATH or MEMORY_NODE_PATH.
MEMORY_AGENT_RUNTIME=pi
MEMORY_NODE_PATH=
# Semantic search. 'local' runs an ONNX model on this machine (no key, no
# network, no data leaves); anything else uses an OpenAI-compatible /embeddings
# endpoint. Unset MEMORY_EMBED_MODEL means lexical-only BM25, which still works.
MEMORY_EMBED_BACKEND=local
MEMORY_EMBED_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_EMBED_CACHE=
# Remote backend only:
MEMORY_EMBED_BASE_URL=
MEMORY_EMBED_API_KEY=
MEMORY_EMBED_BATCH=64
MEMORY_GOTIFY_URL=http://127.0.0.1:18080
# Gotify *Client* token; the application token is for sending, not reading.
MEMORY_GOTIFY_TOKEN=
MEMORY_GITHUB_REPO=zheznanohana/NekoHub
MEMORY_GITHUB_TOKEN=
