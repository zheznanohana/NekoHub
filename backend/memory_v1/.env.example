# The base URL must include the path prefix the provider expects before
# /chat/completions. DeepSeek: https://api.deepseek.com/v1 (models: deepseek-flash).
MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
MEMORY_LLM_MODEL=deepseek-flash
MEMORY_LLM_API_KEY=
MEMORY_SERVICE_TOKEN=
MEMORY_SERVICE_URL=http://127.0.0.1:18081
# Use the same absolute database path for service, web and worker.
MEMORY_DB_PATH=
MEMORY_AUTO_APPLY=false
MEMORY_CONNECTOR_OWNER=admin
# pi runs chat through the Pi agent subprocess; unset falls back to the
# built-in bounded tool loop. Needs Node on PATH or MEMORY_NODE_PATH.
MEMORY_AGENT_RUNTIME=pi
MEMORY_NODE_PATH=
MEMORY_GOTIFY_URL=http://127.0.0.1:18080
# Gotify *Client* token; the application token is for sending, not reading.
MEMORY_GOTIFY_TOKEN=
MEMORY_GITHUB_REPO=zheznanohana/NekoHub
MEMORY_GITHUB_TOKEN=
