{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "event_id",
        "start",
        "end",
        "quote"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "person",
            "project",
            "event",
            "task",
            "place",
            "topic",
            "preference"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "aliases"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "predicate": {
          "enum": [
            "participates_in",
            "belongs_to",
            "located_at",
            "scheduled_for",
            "has_status",
            "prefers",
            "related_to"
          ]
        },
        "object": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "node_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "datatype": {
                  "enum": [
                    "text",
                    "datetime",
                    "decimal",
                    "boolean"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "value",
                "datatype",
                "unit"
              ]
            }
          ]
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "epistemic": {
          "enum": [
            "observed",
            "reported",
            "inferred"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "active",
            "superseded",
            "disputed",
            "retracted",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "object",
        "valid_from",
        "valid_to",
        "epistemic",
        "status",
        "confidence",
        "version",
        "evidence"
      ]
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "memory.ingest"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "gotify",
                "manual",
                "imap",
                "rss",
                "web3",
                "github",
                "import"
              ]
            },
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "external_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "type",
            "instance_id",
            "external_id"
          ]
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 1000
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "fields": {
              "type": "object",
              "maxProperties": 40,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "required": [
            "title",
            "text"
          ]
        },
        "provenance": {
          "enum": [
            "user_authored",
            "external",
            "assistant_generated"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "source",
        "occurred_at",
        "timezone",
        "content",
        "provenance"
      ]
    },
    "changeset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "memory.changeset"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0
        },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "assert"
                  },
                  "fact": {
                    "$ref": "#/$defs/fact"
                  }
                },
                "required": [
                  "op",
                  "fact"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "supersede"
                  },
                  "target_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "fact": {
                    "$ref": "#/$defs/fact"
                  }
                },
                "required": [
                  "op",
                  "target_id",
                  "expected_version",
                  "reason",
                  "fact"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "enum": [
                      "dispute",
                      "retract",
                      "archive"
                    ]
                  },
                  "target_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "op",
                  "target_id",
                  "expected_version",
                  "reason",
                  "evidence"
                ]
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "idempotency_key",
        "extractor_version",
        "nodes",
        "operations"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "memory.query"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "node_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "include_candidates": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "node_ids",
            "include_candidates"
          ]
        },
        "view": {
          "enum": [
            "graph",
            "table",
            "timeline",
            "answer"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "question",
        "filters",
        "view",
        "limit",
        "cursor"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "memory.result"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              },
              "minItems": 0
            },
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              },
              "minItems": 0
            }
          },
          "required": [
            "nodes",
            "facts"
          ]
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "supported",
                "partial",
                "insufficient_evidence"
              ]
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "fact_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "text",
                  "fact_ids"
                ]
              },
              "minItems": 0
            },
            "unknowns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "claims",
            "unknowns"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "as_of",
        "graph",
        "answer",
        "next_cursor"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "memory.error"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "EVIDENCE_MISMATCH",
            "VERSION_CONFLICT",
            "NOT_FOUND",
            "SOURCE_CONFLICT",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "code",
        "message",
        "retryable"
      ]
    }
  },
